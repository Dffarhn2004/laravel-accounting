# Copy to .env OUTSIDE the web document root. Never commit a real .env.
APP_NAME="Laravel Accounting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://accounting.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=warning

# Typical cPanel MySQL or MariaDB setup (DB name/user may be prefixed)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_accounting
DB_USERNAME=cpuser_accounting
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# No always-on Node.js / Inertia SSR service on shared cPanel.
INERTIA_SSR_ENABLED=false
